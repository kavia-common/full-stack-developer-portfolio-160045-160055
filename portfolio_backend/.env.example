# Backend environment configuration for portfolio_backend

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Contact email settings
# Recipient who will receive contact form messages
CONTACT_RECIPIENT_EMAIL=sneha887@gmail.com
# Optional: a default "from" identity if needed by certain SMTP providers (not used by default)
# CONTACT_FROM_EMAIL=portfolio@yourdomain.com

# SMTP configuration (required)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for TLS/SMTPS on port 465, "false" for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
